{
  "name": "bun-react-quiz-app",
  "main": "src/worker.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "build": {
    "command": "bun run build",
    "cwd": ".",
    "watch_dir": "src",
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },

  "dev": {
    "port": 8787,
    "local_protocol": "http",
  },
}
